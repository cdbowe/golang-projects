{
  "name": "golang-projects",
  "workspaceFolder": "/workspaces/golang-projects",
  "workspaceMount": "",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "WORKSPACE_DIR": "/workspaces/golang-projects",
      "TZ": "America/New_York"
    }
  },
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "golang.go",
        "Anthropic.claude-code"
      ]
    }
  },
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "WORKSPACE_DIR": "/workspaces/golang-projects",
    "TZ": "America/New_York",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "WORKTREE_MAIN_DIR": "${containerWorkspaceFolder}/main"
  },
  "remoteUser": "node",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/claude_files,target=${containerWorkspaceFolder}/claude_files,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/main,target=${containerWorkspaceFolder}/main,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/LICENSE,target=${containerWorkspaceFolder}/LICENSE,type=bind,consistency=cached",
    "source=claude-code-home,target=/home/node/.claude,type=volume",
    "source=${localWorkspaceFolder}/../../Tools/AI/claude-code-tools,target=/opt/claude-code-tools,type=bind,readonly",
    "source=${localWorkspaceFolder}/.claude,target=${containerWorkspaceFolder}/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/main,target=${containerWorkspaceFolder}/main,type=bind,consistency=cached"
  ],
  "initializeCommand": "mkdir -p \"${localWorkspaceFolder}/claude_files\" && mkdir -p \"${localWorkspaceFolder}/main\"",
  "postCreateCommand": "sudo chmod +x .devcontainer/scripts/*.sh && bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "sudo chmod +x .devcontainer/scripts/*.sh && bash .devcontainer/scripts/post-start.sh"
}
