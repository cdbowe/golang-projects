# syntax=docker/dockerfile:1.4
# Generated by devcontainer-init
FROM debian:bookworm-slim

######################
# Build ARGs
######################

ARG USERNAME=node
ARG USER_UID=1000
ARG USER_GID=${USER_UID}
ARG WORKSPACE_DIR=/workspaces/golang-projects
# IANA timezone; override via build.args in devcontainer.json.
ARG TZ=America/New_York
# Build-only: keeps tzdata from prompting during the package install below.
ARG DEBIAN_FRONTEND=noninteractive

######################
# Environment
######################

ENV TZ=${TZ}
ENV SHELL=/bin/bash
ENV HOME="/home/${USERNAME}"
ENV DEVCONTAINER=true

######################
# System Packages
######################

RUN apt-get update && apt-get install -y --no-install-recommends \
  git \
  curl \
  wget \
  ca-certificates \
  gnupg2 \
  sudo \
  jq \
  bc \
  less \
  procps \
  nano \
  vim \
  unzip \
  bash \
  bash-completion \
  tzdata \
  && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
  && echo "${TZ}" > /etc/timezone \
  && dpkg-reconfigure -f noninteractive tzdata \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

######################
# Python 3
######################

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

######################
# Go 1.27.0
######################

# dpkg's amd64/arm64 match Go's own naming, so this works on Intel and ARM
# hosts alike.
RUN GO_ARCH="$(dpkg --print-architecture)" \
  && wget -q "https://go.dev/dl/go1.27.0.linux-${GO_ARCH}.tar.gz" -O /tmp/go.tar.gz \
  && tar -C /usr/local -xzf /tmp/go.tar.gz \
  && rm /tmp/go.tar.gz

ENV GOPATH=/go
ENV PATH="/usr/local/go/bin:/go/bin:${PATH}"

# 1777 so the non-root user can write here: it is created further down, so it
# cannot own these yet.
RUN mkdir -p /go/bin /go/pkg && chmod -R 1777 /go

# C toolchain for cgo. Without a C compiler Go sets CGO_ENABLED=0, which
# disables `go test -race`.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

######################
# User Setup
######################

RUN groupadd --gid ${USER_GID} ${USERNAME} 2>/dev/null || true \
  && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} 2>/dev/null || true \
  && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} \
  && chmod 0440 /etc/sudoers.d/${USERNAME}

######################
# Workspace
######################

RUN mkdir -p ${WORKSPACE_DIR} && chown -R ${USER_UID}:${USER_GID} ${WORKSPACE_DIR}
WORKDIR ${WORKSPACE_DIR}

######################
# claude-code-tools runtime deps
######################

# The toolkit's /prd command set shells out to python3 for the topological sort
# and wave splitting in prd-plan.sh and prd-unblock-compile.sh. Not present on
# debian:*-slim. Scoped to the tools integration rather than the base package
# list so containers generated without the checkout stay slim.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

######################
# Claude Code CLI
######################

USER ${USERNAME}
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- 2.1.285

######################
# Go tools
######################

# Installed as the non-root user so /go/bin and the module cache stay writable
# for later `go install` / `go get` calls. Bump versions here, then rebuild.
#   gopls: language server for the VS Code Go extension
#   dlv:   debugger behind "debug test" in VS Code
RUN go install golang.org/x/tools/gopls@v0.23.0 \
  && go install github.com/go-delve/delve/cmd/dlv@v1.27.2 \
  && go clean -cache

######################
# Go module dependencies
######################

# Pre-fills the module cache for every project under projects/ that has a
# go.mod, so tests and builds work offline right after a rebuild. The build
# context is the workspace root (see devcontainer.json), but
# Dockerfile.dockerignore lets only projects/*/go.mod and go.sum through.
# Adding or changing a dependency invalidates only this layer.
COPY --chown=${USER_UID}:${USER_GID} projects/ /tmp/go-mods/
RUN for mod in /tmp/go-mods/*/go.mod; do \
      [ -f "$mod" ] || continue; \
      echo "go mod download: ${mod%/go.mod}"; \
      (cd "${mod%/go.mod}" && go mod download) || exit 1; \
    done \
  && rm -rf /tmp/go-mods
